# Include auto-generated exports header
UNAME := $(shell uname)
ifeq ($(UNAME), Darwin)
  # This logic is macOS-specific and finds the C++ standard library headers (like <cmath>)
  SDK_PATH=$(shell xcrun --show-sdk-path)
  PKG_CPPFLAGS += -I"$(SDK_PATH)/usr/include/c++/v1"
endif

PKG_CPPFLAGS += -I../inst/include

LIBTORCH_INCLUDE := $(shell $(R_HOME)/bin/R -s -e "cat(torch:::torch_install_path())")
PKG_CPPFLAGS += -I"$(LIBTORCH_INCLUDE)"/include/torch/csrc/api/include

# Detect CUDA
# CUDA_HOME must exist as an env var, so not through CUDA_HOME ?= $(shell $(R_HOME)/bin/R CMD config CUDA_HOME)
ifneq (,$(CUDA_HOME))
  HAVE_CUDA := 1
  NVCC := $(CUDA_HOME)/bin/nvcc
  PKG_LIBS += -L"$(CUDA_HOME)/lib64" -lcudart
  PKG_CPPFLAGS += -I"$(CUDA_HOME)/include"
endif

# Source local files
CPPLIBS = \
  cpu/ms_deform_attn_cpu.cpp \
  vision.cpp

# CUDA source
ifneq (,$(HAVE_CUDA))
  CUDA_SOURCES = cuda/ms_deform_attn_cuda.cu
endif
